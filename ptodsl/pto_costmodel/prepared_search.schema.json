{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pto.cv.prepared_search.v1",
  "title": "Prepared CV model-first search input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_features", "input_fingerprint", "package_manifest_sha256", "producer", "compiler_semantics_sha256", "bindings", "target", "candidates", "vfs", "vfs_sha256", "full_device_compilations", "candidate_analysis_seconds", "fingerprint"],
  "properties": {
    "schema": {"const": "pto.cv.prepared_search.v1"},
    "required_features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "input_fingerprint": {"$ref": "#/$defs/digest"},
    "package_manifest_sha256": {"$ref": "#/$defs/digest"},
    "compiler_semantics_sha256": {"$ref": "#/$defs/digest"},
    "fingerprint": {"$ref": "#/$defs/digest"},
    "producer": {"type": "object"},
    "bindings": {"type": "object"},
    "target": {"type": "object"},
    "vfs": {"type": "string", "minLength": 1},
    "vfs_sha256": {"$ref": "#/$defs/digest"},
    "full_device_compilations": {"const": 0},
    "candidate_analysis_seconds": {"type": "number", "minimum": 0},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "input_fingerprint", "candidate_id", "schedule_semantics", "loops", "buffers", "schedule_fingerprint"],
      "properties": {
        "schema": {"const": "pto.cv.prepared_plan.v1"},
        "input_fingerprint": {"$ref": "#/$defs/digest"},
        "candidate_id": {"type": "string", "minLength": 1},
        "schedule_semantics": {"const": "pto.cv.prefix_suffix.iteration_distance.v1"},
        "schedule_fingerprint": {"$ref": "#/$defs/digest"},
        "loops": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["loop_id", "preload_count"],
          "properties": {"loop_id": {"type": "string"}, "preload_count": {"type": "integer", "minimum": 0}}
        }},
        "buffers": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["buffer_id", "count"],
          "properties": {"buffer_id": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}
        }}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "preload_count", "events", "events_sha256", "program", "program_sha256", "plan", "resource"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "preload_count": {"type": "integer", "minimum": 0},
        "events": {"type": "string", "minLength": 1},
        "events_sha256": {"$ref": "#/$defs/digest"},
        "program": {"type": "string", "minLength": 1},
        "program_sha256": {"$ref": "#/$defs/digest"},
        "plan": {"$ref": "#/$defs/plan"},
        "resource": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "bytes_by_domain", "budget", "status", "unresolved_domains"],
          "properties": {
            "basis": {"const": "sum_known_aligned_slots_without_reuse"},
            "bytes_by_domain": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "budget": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "status": {"enum": ["precheck_pass", "unresolved"]},
            "unresolved_domains": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
