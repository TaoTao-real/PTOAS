// Direct VMI control implementation of the attached manual-VF INTERLEAVE
// stage.  Arguments are UB pointers because this function mirrors RopeVF after
// the surrounding Compressor kernel has completed its GM -> UB movement.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @rope_partial_interleave_vmi_n8(
      %sin: !pto.ptr<f32, ub>, %cos: !pto.ptr<f32, ub>,
      %input: !pto.ptr<f32, ub>, %output: !pto.ptr<bf16, ub>)
      attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c64 = arith.constant 64 : index
    %c448 = arith.constant 448 : index
    %c512 = arith.constant 512 : index
    %minus_one = arith.constant -1.0 : f32
    pto.vecscope {
      %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      %minus_one_v = pto.vmi.vbrc %minus_one : f32 -> !pto.vmi.vreg<64xf32>
      scf.for %row = %c0 to %c8 step %c1 {
        %row_input = arith.muli %row, %c512 : index
        %row_trig = arith.muli %row, %c64 : index
        %rotary_input = arith.addi %row_input, %c448 : index

        %x = pto.vmi.vload %input[%rotary_input]
            : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        %cos_v = pto.vmi.vload %cos[%row_trig]
            : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        %sin_v = pto.vmi.vload %sin[%row_trig]
            : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        %cos_x = pto.vmi.vmul %cos_v, %x, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>

        // vdintlv(x,x) produces the even and odd subsequences twice; vintlv
        // reconstructs [-x1,x0,-x3,x2,...].  Only the low result is live.
        %even, %odd = pto.vmi.vdintlv %x, %x, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred>
            -> !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>
        %negative_odd = pto.vmi.vmul %odd, %minus_one_v, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
        %rotated, %unused = pto.vmi.vintlv %negative_odd, %even, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred>
            -> !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>
        %sin_rot = pto.vmi.vmul %sin_v, %rotated, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
        %out_f32 = pto.vmi.vadd %cos_x, %sin_rot, %mask
            : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
              !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
        %out_bf16 = pto.vmi.vcvt %out_f32
            {rounding = "R", saturate = "NOSAT"}
            : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
        pto.vmi.vstore %out_bf16, %output[%rotary_input], %mask
            : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>,
              !pto.vmi.mask<64xpred>

        scf.for %col = %c0 to %c448 step %c64 {
          %prefix_offset = arith.addi %row_input, %col : index
          %prefix = pto.vmi.vload %input[%prefix_offset]
              : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
          %prefix_bf16 = pto.vmi.vcvt %prefix
              {rounding = "R", saturate = "NOSAT"}
              : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
          pto.vmi.vstore %prefix_bf16, %output[%prefix_offset], %mask
              : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>,
                !pto.vmi.mask<64xpred>
        }
      }
    }
    return
  }
}
