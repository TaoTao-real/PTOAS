// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @compact_scalar_masked_memory(
      %src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %offset: index,
      %mask: !pto.vmi.mask<1xb32, #pto.vmi.layout<contiguous>>) {
    %value = pto.vmi.load %src[%offset]
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    pto.vmi.masked_store %value, %dst[%offset], %mask
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
          !pto.ptr<f32, ub>,
          !pto.vmi.mask<1xb32, #pto.vmi.layout<contiguous>>
    return
  }

  func.func @compact_scalar_unmasked_store(
      %value: !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
      %dst: !pto.ptr<f32, ub>, %offset: index) {
    pto.vmi.store %value, %dst[%offset]
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
          !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @compact_scalar_masked_memory(
// CHECK-SAME: %[[SRC:.*]]: !pto.ptr<f32, ub>, %[[DST:.*]]: !pto.ptr<f32, ub>, %[[OFFSET:.*]]: index, %[[MASK:.*]]: !pto.mask<b32>
// CHECK: %[[VALUE:.*]] = pto.vlds %[[SRC]][%[[OFFSET]]] {dist = "BRC_B32"} : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
// CHECK: pto.vsts %[[VALUE]], %[[DST]][%[[OFFSET]]], %[[MASK]] {dist = "1PT_B32"}

// CHECK-LABEL: func.func @compact_scalar_unmasked_store(
// CHECK: %[[VL1:.*]] = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
// CHECK: pto.vsts %arg0, %arg1[%arg2], %[[VL1]] {dist = "1PT_B32"}
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
