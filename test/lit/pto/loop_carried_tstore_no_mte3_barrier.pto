// Consecutive tstores are ordered on PIPE_MTE3. Do not drain MTE3 before every
// loop iteration; retain the final PIPE_ALL drain generated by InsertSync.
//
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --mlir-print-ir-after=pto-insert-sync %s 2>&1 1>/dev/null | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @loop_carried_tstore(
      %src: memref<4096xbf16, #pto.address_space<vec>>,
      %dst: memref<4096xbf16, #pto.address_space<gm>>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c4096 = arith.constant 4096 : index

    scf.for %offset = %c0 to %c4096 step %c64 {
      %src_chunk = memref.subview %src[%offset] [64] [1]
          : memref<4096xbf16, #pto.address_space<vec>>
            to memref<64xbf16, strided<[1], offset: ?>, #pto.address_space<vec>>
      %dst_chunk = memref.subview %dst[%offset] [64] [1]
          : memref<4096xbf16, #pto.address_space<gm>>
            to memref<64xbf16, strided<[1], offset: ?>, #pto.address_space<gm>>
      pto.tstore ins(%src_chunk : memref<64xbf16, strided<[1], offset: ?>, #pto.address_space<vec>>)
                 outs(%dst_chunk : memref<64xbf16, strided<[1], offset: ?>, #pto.address_space<gm>>)
    }
    return
  }
}

// CHECK-LABEL: func.func @loop_carried_tstore
// CHECK:       scf.for
// CHECK-NOT:     pto.barrier <PIPE_MTE3>
// CHECK:         pto.tstore
// CHECK:       pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier}
