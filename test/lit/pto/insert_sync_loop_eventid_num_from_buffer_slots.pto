// CHECK-NEXT: wait_flag(PIPE_MTE3, PIPE_MTE2, [[WAIT]]);
// CHECK: event_t [[SET:v[0-9]+]] = (event_t) [[SEL]];
// CHECK-NEXT: set_flag(PIPE_MTE3, PIPE_MTE2, [[SET]]);
// CHECK: wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
// CHECK-NEXT: wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID1);
