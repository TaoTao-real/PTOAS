module {
  func.func @zero_columns(%src: !pto.tile_buf<vec, 16x128xf16, valid=0x0>, %dst: !pto.tile_buf<vec, 16x128xf16, valid=0x0, blayout=col_major, slayout=row_major>) {
    pto.tmov ins(%src : !pto.tile_buf<vec, 16x128xf16, valid=0x0>) outs(%dst : !pto.tile_buf<vec, 16x128xf16, valid=0x0, blayout=col_major, slayout=row_major>)
