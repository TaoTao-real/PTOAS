module {
  func.func @padded(%src: !pto.tile_buf<vec, 8x128xf16>, %dst: !pto.tile_buf<vec, 16x128xf16, valid=8x128, blayout=col_major, slayout=row_major>) {
    pto.tmov ins(%src : !pto.tile_buf<vec, 8x128xf16>) outs(%dst : !pto.tile_buf<vec, 16x128xf16, valid=8x128, blayout=col_major, slayout=row_major>)
