// RUN: pto-test-opt %s -pto-cv-apply-schedule | FileCheck %s
// RUN: pto-test-opt %s -pto-cv-apply-schedule -pto-plan-memory -pto-resolve-buffer-select | FileCheck %s --check-prefix=BOUND
// RUN: sed 's/0, 1, 0, 2/0, 1, 0, 3/' %s > %t.bad
// RUN: not pto-test-opt %t.bad -pto-cv-apply-schedule 2>&1 | FileCheck %s --check-prefix=BAD
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @pure_vector() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %input = pto.alloc_tile {pto.pipeline.iteration_slots = [0, 0, 0, 0]} : !pto.tile_buf<vec, 32x32xf32>
    %p = pto.alloc_tile {pto.costmodel.buffer_id = "P", pto.pipeline.multi_buffer_count = 3 : i64, pto.pipeline.iteration_slots = [0, 1, 0, 2]} : !pto.tile_buf<vec, 32x32xf32>
    %output = pto.alloc_tile {pto.pipeline.iteration_slots = [0, 0, 0, 0]} : !pto.tile_buf<vec, 32x32xf32>
    scf.for %i = %c0 to %c4 step %c1 {
      pto.tneg ins(%input : !pto.tile_buf<vec, 32x32xf32>) outs(%p : !pto.tile_buf<vec, 32x32xf32>)
      pto.tadd ins(%p, %p : !pto.tile_buf<vec, 32x32xf32>, !pto.tile_buf<vec, 32x32xf32>) outs(%output : !pto.tile_buf<vec, 32x32xf32>)
    } {pto.pipeline.single_core, pto.costmodel.loop_id = "L0"}
    return
  }
}
// CHECK: pto.alloc_multi_tile
// CHECK-SAME: pto.costmodel.buffer_id = "P"
// CHECK-SAME: pto.cv.required_slots = 3
// CHECK: pto.tneg
// CHECK-SAME: pto.cv.iteration = 0
// CHECK: pto.tadd
// CHECK-SAME: pto.cv.iteration = 0
// CHECK: pto.tneg
// CHECK-SAME: pto.cv.iteration = 1
// CHECK: pto.tadd
// CHECK-SAME: pto.cv.iteration = 1
// CHECK: pto.tneg
// CHECK-SAME: pto.cv.iteration = 2
// CHECK: pto.tadd
// CHECK-SAME: pto.cv.iteration = 2
// CHECK: pto.tneg
// CHECK-SAME: pto.cv.iteration = 3
// CHECK: pto.tadd
// CHECK-SAME: pto.cv.iteration = 3
// BOUND: pto.costmodel.buffer_id = "P"{{.*}}pto.cv.slot = 0
// BOUND: pto.costmodel.buffer_id = "P"{{.*}}pto.cv.slot = 1
// BOUND: pto.costmodel.buffer_id = "P"{{.*}}pto.cv.slot = 2
// BAD: invalid single-core iteration slot
