// RUN: pto-test-opt %s -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir | FileCheck %s


module {
  func.func @vmi_layout_assignment_group_slot_load_slots1_unaligned_stride_invalid(
      %src: !pto.ptr<f32, ub>, %off: index) {
    %c2 = arith.constant 2 : index
    %out = pto.vmi.group_slot_load %src[%off], %c2 {num_groups = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return
  }
}

// When the source group stride is not the constant 1 the preferred form is the
// single-carrier slots=1 packet (see getPreferredGroupSlotLoadLayout), so the load
// is assigned one group slot per part rather than eight.
// CHECK: pto.vmi.group_slot_load
// CHECK-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
