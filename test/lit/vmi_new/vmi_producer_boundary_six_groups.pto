// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -pto-validate-vmi-ir -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir | FileCheck %s

module {
  func.func @vmi_producer_boundary_six_groups(
      %source: !pto.vmi.vreg<192xf32>,
      %mask: !pto.vmi.mask<192xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    %sum = pto.vmi.vcadd %source, %mask
        {group = 6, reassoc}
        : !pto.vmi.vreg<192xf32>, !pto.vmi.mask<192xpred>
        -> !pto.vmi.vreg<6xf32>
    pto.vmi.vstore %sum, %dst[%off], %c1 {group = 6}
        : !pto.vmi.vreg<6xf32>, !pto.ptr<f32, ub>
    return
  }
}

// A six-group tail has a dense executable layout. Both stage gates must use
// that capability rather than imposing a physical instruction group limit.
// CHECK-LABEL: func.func @vmi_producer_boundary_six_groups
// CHECK: pto.vmi.group_reduce_addf
// CHECK-SAME: -> !pto.vmi.vreg<6xf32, #pto.vmi.layout<num_groups = 6, slots = 1>>
// CHECK: pto.vmi.group_store
// CHECK-SAME: {num_groups = 6 : i64}
