// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto 2>&1 | FileCheck %s


module {
  func.func @vmi_layout_gate_group_reduce_slots1_support_invalid(
      %source: !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vcadd %source, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
    return
  }
}

// Eight groups reduce into one carrier slot per group, so the natural result layout
// is slots = 8; the hand-written slots = 1 result contradicts it and layout
// assignment rejects the module instead of silently picking one of the two.
// CHECK: VMI-LAYOUT-CONTRACT: conflicting natural layouts
// CHECK-SAME: slots = 1
// CHECK-SAME: slots = 8
