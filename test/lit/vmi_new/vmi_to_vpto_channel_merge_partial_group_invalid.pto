// RUN: not pto-test-opt %s -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @vmi_to_vpto_channel_merge_partial_group_invalid(
      %ch0: !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>,
      %ch1: !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>) {
    %merged = "pto.vmi.channel_merge"(%ch0, %ch1)
        : (!pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>,
           !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>)
        -> !pto.vmi.vreg<4xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: VMI{{-}}UNSUPPORTED{{:}} pto.vmi.channel_merge requires every input layout to be contiguous
// CHECK-SAME: complete physical channel groups
// CHECK-SAME: requires full result logical 256-byte chunks
