// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @compact_elementwise_masks(
      %lhs: !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
      %rhs: !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> {
    %sum = pto.vmi.addf %lhs, %rhs
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %product = pto.vmi.mulf %sum, %rhs
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %root = pto.vmi.sqrt %product
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return %root : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @full_elementwise_masks(
      %lhs: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %rhs: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %sum = pto.vmi.addf %lhs, %rhs
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %product = pto.vmi.mulf %sum, %rhs
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %root = pto.vmi.sqrt %product
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %root : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }
}

// CHECK-LABEL: func.func @compact_elementwise_masks(
// CHECK: %[[VL1A:.*]] = pto.pge_b32 "PAT_VL1"
// CHECK: %[[SUM:.*]] = pto.vadd %{{.*}}, %{{.*}}, %[[VL1A]]
// CHECK: %[[VL1B:.*]] = pto.pge_b32 "PAT_VL1"
// CHECK: %[[PRODUCT:.*]] = pto.vmul %[[SUM]], %{{.*}}, %[[VL1B]]
// CHECK: %[[VL1C:.*]] = pto.pge_b32 "PAT_VL1"
// CHECK: %[[ROOT:.*]] = pto.vsqrt %[[PRODUCT]], %[[VL1C]]
// CHECK: return %[[ROOT]] : !pto.vreg<64xf32>

// CHECK-LABEL: func.func @full_elementwise_masks(
// CHECK: pto.pset_b32 "PAT_ALL"
// CHECK: pto.vadd
// CHECK: pto.pset_b32 "PAT_ALL"
// CHECK: pto.vmul
// CHECK: pto.pset_b32 "PAT_ALL"
// CHECK: pto.vsqrt
// CHECK-NOT: pto.pge_b32 "PAT_VL1"
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
