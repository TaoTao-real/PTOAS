// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

module {
  func.func @compact_scalar_memory(
      %src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %offset: index) {
    %c1 = arith.constant 1 : index
    %mask = pto.vmi.create_mask %c1 : index -> !pto.vmi.mask<1xpred>
    %value = pto.vmi.vload %src[%offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
    pto.vmi.vstore %value, %dst[%offset], %mask
        : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<1xpred>
    return
  }
}

// CHECK-LABEL: func.func @compact_scalar_memory(
// CHECK: %[[VL1:.*]] = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
// CHECK: %[[VALUE:.*]] = pto.vlds %arg0[%arg2] {dist = "BRC_B32"} : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
// CHECK: pto.vsts %[[VALUE]], %arg1[%arg2], %[[VL1]] {dist = "1PT_B32"}
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
