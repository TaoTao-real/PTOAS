// A=B+C; D=A*B elementwise fusion cases on the A5 tile-fusion path.
//
// Decisions are cost-model snapshots for the pinned VfSimulator commit
// f4ba4ecaf1fc ("Align legacy template selection with PTOAS").  If the
// submodule is ever bumped and a decision changes, update the expected values
// together with the bump.
//
//   @vfsim_unroll_chain6_32x128    - six-op chain (tadd/tmul x3): the model
//     picks AABBCC unroll=8, so the fusion region is annotated with
//     col_unroll_factor = 8; after pto-low-level-loop-fusion the streaming
//     loop still runs step 64 with six carried tiles, and
//     pto-unroll-after-loop-fusion rescales it to step 512 with 48
//     vadd/vmul copies (3+3 ops x 8), resetting the consumed attribute.
//   @vfsim_unroll_tadd_tmul_32x128 - plain tadd+tmul pair: the model picks
//     NO_UNROLL; both factors stay 1, the loop keeps step 64 and the body
//     keeps a single vadd/vmul pair.
//
// REQUIRES: vfsim-costmodel
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion --enable-vfsim-costmodel-optimization --emit-pto-ir %s --mlir-print-ir-after=pto-fusion-region-gen -o /dev/null > %t.region 2>&1
// RUN: FileCheck %s --check-prefix=REGION < %t.region
// RUN: FileCheck %s --check-prefix=CHAIN-REGION < %t.region
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion --enable-vfsim-costmodel-optimization --emit-vpto %s --mlir-print-ir-after=pto-low-level-loop-fusion -o /dev/null > %t.llf 2>&1
// RUN: FileCheck %s --check-prefix=LLF < %t.llf
// RUN: FileCheck %s --check-prefix=CHAIN-LLF < %t.llf
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion --enable-vfsim-costmodel-optimization --enable-unroll-after-loop-fusion --emit-vpto %s --mlir-print-ir-after=pto-unroll-after-loop-fusion -o /dev/null > %t.unroll 2>&1
// RUN: FileCheck %s --check-prefix=UNROLL < %t.unroll
// RUN: FileCheck %s --check-prefix=CHAIN-UNROLL < %t.unroll

// Function-pass dumps may arrive in either order. Check each function separately
// while preserving the ordered assertions within each function.

// REGION-LABEL: func.func @vfsim_unroll_tadd_tmul_32x128(
// REGION: pto.fusion_region {
// REGION: pto.tadd
// REGION: pto.tmul
// REGION: } {pto.fusion.col_unroll_factor = 1 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}
// CHAIN-REGION-LABEL: func.func @vfsim_unroll_chain6_32x128(
// CHAIN-REGION: pto.fusion_region {
// CHAIN-REGION: pto.tadd
// CHAIN-REGION: pto.tmul
// CHAIN-REGION: } {pto.fusion.col_unroll_factor = 8 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}

// LLF-LABEL: func.func @vfsim_unroll_tadd_tmul_32x128(
// LLF: pto.fusion_region {
// LLF: %{{[a-zA-Z0-9_]+}}:2 = scf.for %{{[a-zA-Z0-9_]+}} = %c0 to %c4096 step %c64
// LLF: } {pto.fusion.col_unroll_factor = 1 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}
// CHAIN-LLF-LABEL: func.func @vfsim_unroll_chain6_32x128(
// CHAIN-LLF: pto.fusion_region {
// CHAIN-LLF: %{{[a-zA-Z0-9_]+}}:6 = scf.for %{{[a-zA-Z0-9_]+}} = %c0 to %c4096 step %c64
// CHAIN-LLF: } {pto.fusion.col_unroll_factor = 8 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}

// UNROLL-LABEL: func.func @vfsim_unroll_tadd_tmul_32x128(
// UNROLL: pto.fusion_region {
// UNROLL: %{{[a-zA-Z0-9_]+}}:2 = scf.for %{{[a-zA-Z0-9_]+}} = %c0 to %c4096 step %c64
// UNROLL: pto.vadd
// UNROLL: pto.vmul
// UNROLL-NOT: pto.v{{add|mul}}
// UNROLL: } {pto.fusion.col_unroll_factor = 1 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}
// CHAIN-UNROLL-LABEL: func.func @vfsim_unroll_chain6_32x128(
// CHAIN-UNROLL: pto.fusion_region {
// CHAIN-UNROLL: %{{[a-zA-Z0-9_]+}}:6 = scf.for %{{[a-zA-Z0-9_]+}} = %c0 to %c4096 step %c512
// CHAIN-UNROLL-COUNT-48: pto.v{{add|mul}}
// CHAIN-UNROLL: } {pto.fusion.col_unroll_factor = 1 : i64, pto.fusion.group_id = 0 : i64, pto.fusion.row_unroll_factor = 1 : i64}

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vfsim_unroll_tadd_tmul_32x128(
      %b_ptr: !pto.ptr<f32>,
      %c_ptr: !pto.ptr<f32>,
      %d_ptr: !pto.ptr<f32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c128 = arith.constant 128 : index

    %b_view = pto.make_tensor_view %b_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %c_view = pto.make_tensor_view %c_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %d_view = pto.make_tensor_view %d_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %b_part = pto.partition_view %b_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %c_part = pto.partition_view %c_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %d_part = pto.partition_view %d_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>

    %b = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %d = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>

    pto.tload ins(%b_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%b : !pto.tile_buf<vec, 32x128xf32>)
    pto.tload ins(%c_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%c : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%b, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%a : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%a, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%d : !pto.tile_buf<vec, 32x128xf32>)
    pto.tstore ins(%d : !pto.tile_buf<vec, 32x128xf32>)
               outs(%d_part : !pto.partition_tensor_view<32x128xf32>)
    return
  }

  func.func @vfsim_unroll_chain6_32x128(
      %b_ptr: !pto.ptr<f32>,
      %c_ptr: !pto.ptr<f32>,
      %d_ptr: !pto.ptr<f32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c128 = arith.constant 128 : index

    %b_view = pto.make_tensor_view %b_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %c_view = pto.make_tensor_view %c_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %d_view = pto.make_tensor_view %d_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %b_part = pto.partition_view %b_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %c_part = pto.partition_view %c_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %d_part = pto.partition_view %d_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>

    %b = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %t0 = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %t1 = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %d = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>

    pto.tload ins(%b_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%b : !pto.tile_buf<vec, 32x128xf32>)
    pto.tload ins(%c_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%c : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%b, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t1 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%t1, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t1 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%t1, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%d : !pto.tile_buf<vec, 32x128xf32>)
    pto.tstore ins(%d : !pto.tile_buf<vec, 32x128xf32>)
               outs(%d_part : !pto.partition_tensor_view<32x128xf32>)
    return
  }
}
