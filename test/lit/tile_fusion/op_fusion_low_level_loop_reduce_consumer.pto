// RUN: pto-test-opt %s -pto-low-level-loop-fusion | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @row_sum_then_broadcast() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %one = arith.constant 1 : i32
    %wide = arith.constant 64 : i32
    %zero = arith.constant 0.0 : f32
    %src = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf32>
    %sum = pto.alloc_tile : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf32>
    %scope = pto.fusion_region {
      %mask, %unused = pto.plt_b32 %wide : i32 -> !pto.mask<b32>, i32
      %scalar, %unused_scalar = pto.plt_b32 %one : i32 -> !pto.mask<b32>, i32
      %initial = pto.vbr %zero : f32 -> !pto.vreg<64xf32>
      %x = pto.tile_buf_addr %src : !pto.tile_buf<vec, 2x128xf32> -> !pto.ptr<f32, ub>
      %s = pto.tile_buf_addr %sum : !pto.tile_buf<vec, 8x1xf32, blayout=col_major> -> !pto.ptr<f32, ub>
      %out = pto.tile_buf_addr %dst : !pto.tile_buf<vec, 2x128xf32> -> !pto.ptr<f32, ub>
      scf.for %row = %c0 to %c2 step %c1 {
        %start = arith.muli %row, %c128 : index
        %acc = scf.for %col = %c0 to %c128 step %c64 iter_args(%prev = %initial) -> (!pto.vreg<64xf32>) {
          %off = arith.addi %start, %col : index
          %vec = pto.vlds %x[%off] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
          %part = pto.vcadd %vec, %mask : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
          %next = pto.vadd %prev, %part, %scalar : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
          scf.yield %next : !pto.vreg<64xf32>
        }
        %row_ptr = pto.addptr %s, %row : <f32, ub> -> <f32, ub>
        pto.vsts %acc, %row_ptr[%c0], %scalar {dist = "1PT_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      }
      scf.for %row = %c0 to %c2 step %c1 {
        %start = arith.muli %row, %c128 : index
        scf.for %col = %c0 to %c128 step %c64 {
          %off = arith.addi %start, %col : index
          %value = pto.vlds %s[%row] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
          %broadcast = pto.vdup %value, %mask {position = "LOWEST"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
          pto.vsts %broadcast, %out[%off], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
        }
      }
      pto.yield(%c0) : (index) -> ()
    } : index
    return
  }
}

// CHECK-LABEL: func.func @row_sum_then_broadcast
// CHECK: %[[SUM:[0-9]+]] = pto.tile_buf_addr %{{[0-9]+}} : !pto.tile_buf<vec, 8x1xf32
// CHECK: scf.for
// CHECK: scf.for
// CHECK: pto.vcadd
// CHECK: %[[ROW_PTR:.*]] = pto.addptr %[[SUM]],
// CHECK: pto.vsts %{{.*}}, %[[ROW_PTR]][
// CHECK: scf.for
// CHECK: scf.for
// CHECK: pto.vlds %[[SUM]][
// CHECK: pto.vdup
