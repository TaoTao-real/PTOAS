// RUN: pto-test-opt %s -pto-fusion-load-store-elision | FileCheck %s

!tile = memref<1x64xf32, #pto.address_space<vec>>

module {
  func.func private @touch_ub(!pto.ptr<f32, ub>)

  func.func @forward_unique_row_preheader(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 41216 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload_storage = pto.pointer_cast(%addr) : !tile
    %reload_ptr = pto.castptr %reload_storage : !tile -> !pto.ptr<f32, ub>
    %reload = pto.vlds %reload_ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_sync(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 41472 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    pto.mem_bar "VST_VLD"
    %reload_storage = pto.pointer_cast(%addr) : !tile
    %reload_ptr = pto.castptr %reload_storage : !tile -> !pto.ptr<f32, ub>
    %reload = pto.vlds %reload_ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_escape(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 41728 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    %escape = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    %observed = pto.vadd %escape, %rhs, %all
        : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
        -> !pto.vreg<64xf32>
    return
  }

  func.func @reject_dynamic_address(
      %addr: i64, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_alias_write(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 41984 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    %alias_storage = pto.pointer_cast(%addr) : !tile
    %alias_ptr = pto.castptr %alias_storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %rhs, %alias_ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_non_full_mask(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 42240 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %vl32 = pto.pge_b32 "PAT_VL32" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %vl32
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_unknown_call(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 42496 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    func.call @touch_ub(%ptr) : (!pto.ptr<f32, ub>) -> ()
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }

  func.func @reject_multiple_pipelines(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %addr = arith.constant 42752 : i64
    %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %storage = pto.pointer_cast(%addr) : !tile
    %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
    pto.vsts %input, %ptr[%c0], %all
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    %reload = pto.vlds %ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    scf.for %row = %c0 to %c4 step %c1 {
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    } {pto.vmi.fusion.kind = "loop_pipeline"}
    return
  }
}

// CHECK-LABEL: func.func @forward_unique_row_preheader(
// CHECK-NOT: pto.vsts
// CHECK-NOT: pto.vlds
// CHECK: scf.for
// CHECK: pto.vadd %arg0, %arg1

// CHECK-LABEL: func.func @reject_sync(
// CHECK: pto.vsts
// CHECK: pto.mem_bar
// CHECK: %[[SYNC_RELOAD:.*]] = pto.vlds
// CHECK: scf.for
// CHECK: pto.vadd %[[SYNC_RELOAD]],

// CHECK-LABEL: func.func @reject_escape(
// CHECK: pto.vsts
// CHECK: %[[LOOP_RELOAD:.*]] = pto.vlds
// CHECK: scf.for
// CHECK: pto.vadd %[[LOOP_RELOAD]],
// CHECK: %[[ESCAPE:.*]] = pto.vlds
// CHECK: pto.vadd %[[ESCAPE]],

// CHECK-LABEL: func.func @reject_dynamic_address(
// CHECK: pto.vsts
// CHECK: %[[DYNAMIC:.*]] = pto.vlds
// CHECK: pto.vadd %[[DYNAMIC]],

// CHECK-LABEL: func.func @reject_alias_write(
// CHECK: pto.vsts
// CHECK: %[[ALIAS:.*]] = pto.vlds
// CHECK: pto.vsts
// CHECK: pto.vadd %[[ALIAS]],

// CHECK-LABEL: func.func @reject_non_full_mask(
// CHECK: pto.vsts
// CHECK: %[[PARTIAL:.*]] = pto.vlds
// CHECK: pto.vadd %[[PARTIAL]],

// CHECK-LABEL: func.func @reject_unknown_call(
// CHECK: pto.vsts
// CHECK: call @touch_ub
// CHECK: %[[UNKNOWN:.*]] = pto.vlds
// CHECK: pto.vadd %[[UNKNOWN]],

// CHECK-LABEL: func.func @reject_multiple_pipelines(
// CHECK: pto.vsts
// CHECK: %[[MULTI:.*]] = pto.vlds
// CHECK: pto.vadd %[[MULTI]],
// CHECK: pto.vadd %[[MULTI]],
