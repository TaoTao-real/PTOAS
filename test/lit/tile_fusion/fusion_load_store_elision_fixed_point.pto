// RUN: pto-test-opt %s -pto-fusion-load-store-elision | FileCheck %s

!tile = memref<1x64xf32, #pto.address_space<vec>>

module {
  // CHECK-LABEL: func.func @dead_later_address_scaffold(
  // CHECK: %[[SUM:.*]] = pto.vadd %arg0, %arg1,
  // CHECK-NOT: pto.vlds
  // CHECK-NOT: pto.vsts
  // CHECK-NOT: pto.pointer_cast
  // CHECK: return
  func.func @dead_later_address_scaffold(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %addr = arith.constant 40960 : i64
    %mask = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %unused = pto.fusion_region {
      %storage = pto.pointer_cast(%addr) : !tile
      %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
      pto.vsts %input, %ptr[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload_storage = pto.pointer_cast(%addr) : !tile
      %reload_ptr = pto.castptr %reload_storage : !tile -> !pto.ptr<f32, ub>
      %reload = pto.vlds %reload_ptr[%c0]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %sum = pto.vadd %reload, %rhs, %mask
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.yield(%sum) : (!pto.vreg<64xf32>) -> ()
    } {pto.fusion.group_id = 0 : i64} : !pto.vreg<64xf32>
    "pto.fusion_region"() ({
      %dead_storage = pto.pointer_cast(%addr) : !tile
      %dead_ptr = pto.castptr %dead_storage : !tile -> !pto.ptr<f32, ub>
      pto.yield() : () -> ()
    }) {pto.fusion.group_id = 1 : i64} : () -> ()
    return
  }

  // CHECK-LABEL: func.func @live_later_address_use(
  // CHECK-NOT: pto.vlds
  // CHECK: pto.vsts %arg0
  // CHECK-NOT: pto.vlds
  // CHECK: %[[OBSERVED:.*]] = pto.vlds
  // CHECK: pto.vadd %[[OBSERVED]], %arg1,
  // CHECK: return
  func.func @live_later_address_use(
      %input: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %addr = arith.constant 40960 : i64
    %mask = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    %unused = pto.fusion_region {
      %storage = pto.pointer_cast(%addr) : !tile
      %ptr = pto.castptr %storage : !tile -> !pto.ptr<f32, ub>
      pto.vsts %input, %ptr[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload_storage = pto.pointer_cast(%addr) : !tile
      %reload_ptr = pto.castptr %reload_storage : !tile -> !pto.ptr<f32, ub>
      %reload = pto.vlds %reload_ptr[%c0]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %sum = pto.vadd %reload, %rhs, %mask
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.yield(%sum) : (!pto.vreg<64xf32>) -> ()
    } {pto.fusion.group_id = 2 : i64} : !pto.vreg<64xf32>
    %observed_storage = pto.pointer_cast(%addr) : !tile
    %observed_ptr = pto.castptr %observed_storage : !tile -> !pto.ptr<f32, ub>
    %observed = pto.vlds %observed_ptr[%c0]
        : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    %kept = pto.vadd %observed, %rhs, %mask
        : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
        -> !pto.vreg<64xf32>
    return
  }
}
