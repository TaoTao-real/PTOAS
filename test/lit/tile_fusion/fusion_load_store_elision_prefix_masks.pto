// RUN: pto-test-opt %s -pto-fusion-load-store-elision | FileCheck %s

module {
  func.func @equivalent_prefix_masks(
      %buffer: !pto.ptr<f32, ub>, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1_i32 = arith.constant 1 : i32
    %unused = pto.fusion_region {
      %vl1 = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
      %prefix, %remaining = pto.plt_b32 %c1_i32 : i32 -> !pto.mask<b32>, i32
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %store_mask = pto.pand %vl1, %prefix, %all
          : !pto.mask<b32>, !pto.mask<b32>, !pto.mask<b32>
          -> !pto.mask<b32>
      pto.vsts %input, %buffer[%c0], %store_mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload = pto.vlds %buffer[%c0]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %sum = pto.vadd %reload, %rhs, %vl1
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.vsts %sum, %buffer[%c0], %store_mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.yield(%c0) : (index) -> ()
    } {pto.fusion.group_id = 0 : i64} : index
    return
  }

  func.func @different_prefix_masks(
      %buffer: !pto.ptr<f32, ub>, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %vl2 = pto.pge_b32 "PAT_VL2" : !pto.mask<b32>
    %vl1 = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
    %unused = pto.fusion_region {
      pto.vsts %input, %buffer[%c0], %vl2
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload = pto.vlds %buffer[%c0]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %sum = pto.vadd %reload, %rhs, %vl1
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.vsts %sum, %buffer[%c0], %vl1
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.yield(%c0) : (index) -> ()
    } {pto.fusion.group_id = 1 : i64} : index
    return
  }

  func.func @scalar_broadcast_forward(
      %buffer: !pto.ptr<f32, ub>, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %vl1 = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
    %unused = pto.fusion_region {
      pto.vsts %input, %buffer[%c0], %vl1
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload = pto.vlds %buffer[%c0] {dist = "BRC_B32"}
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
      %sum = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.yield(%sum) : (!pto.vreg<64xf32>) -> ()
    } {pto.fusion.group_id = 2 : i64} : !pto.vreg<64xf32>
    return
  }

  func.func @scalar_broadcast_reject_multiple_use(
      %buffer: !pto.ptr<f32, ub>, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %vl1 = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
    %unused = pto.fusion_region {
      pto.vsts %input, %buffer[%c0], %vl1
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload = pto.vlds %buffer[%c0] {dist = "BRC_B32"}
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %all = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
      %sum0 = pto.vadd %reload, %rhs, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      %sum1 = pto.vadd %reload, %sum0, %all
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.yield(%sum1) : (!pto.vreg<64xf32>) -> ()
    } {pto.fusion.group_id = 3 : i64} : !pto.vreg<64xf32>
    return
  }

  func.func @scalar_broadcast_reject_non_full_consumer_mask(
      %buffer: !pto.ptr<f32, ub>, %input: !pto.vreg<64xf32>,
      %rhs: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %vl1 = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
    %unused = pto.fusion_region {
      pto.vsts %input, %buffer[%c0], %vl1
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %reload = pto.vlds %buffer[%c0] {dist = "BRC_B32"}
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %vl32 = pto.pge_b32 "PAT_VL32" : !pto.mask<b32>
      %sum = pto.vadd %reload, %rhs, %vl32
          : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
          -> !pto.vreg<64xf32>
      pto.yield(%sum) : (!pto.vreg<64xf32>) -> ()
    } {pto.fusion.group_id = 4 : i64} : !pto.vreg<64xf32>
    return
  }
}

// CHECK-LABEL: func.func @equivalent_prefix_masks(
// CHECK: pto.fusion_region
// CHECK-NOT: pto.vlds
// CHECK: %[[SUM:.*]] = pto.vadd %arg1, %arg2, %{{.*}}
// CHECK-COUNT-1: pto.vsts
// CHECK: pto.yield

// CHECK-LABEL: func.func @different_prefix_masks(
// CHECK: pto.fusion_region
// CHECK: pto.vsts
// CHECK: %[[DIFF_RELOAD:.*]] = pto.vlds
// CHECK: pto.vadd %[[DIFF_RELOAD]],
// CHECK: pto.vsts
// CHECK: pto.yield

// CHECK-LABEL: func.func @scalar_broadcast_forward(
// CHECK: pto.vsts %arg1
// CHECK-NOT: pto.vlds
// CHECK: %[[BRC:.*]] = pto.vdup %arg1, %{{.*}} {position = "LOWEST"}
// CHECK: pto.vadd %[[BRC]], %arg2
// CHECK: pto.yield

// CHECK-LABEL: func.func @scalar_broadcast_reject_multiple_use(
// CHECK: pto.vsts
// CHECK: %[[RELOAD:.*]] = pto.vlds
// CHECK: pto.vadd %[[RELOAD]],
// CHECK: pto.vadd %[[RELOAD]],

// CHECK-LABEL: func.func @scalar_broadcast_reject_non_full_consumer_mask(
// CHECK: pto.vsts
// CHECK: %[[PARTIAL_RELOAD:.*]] = pto.vlds
// CHECK: pto.vadd %[[PARTIAL_RELOAD]],
