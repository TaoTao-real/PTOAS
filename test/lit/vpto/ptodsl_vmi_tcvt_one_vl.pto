// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-select-tilelib-candidate 2>&1 | FileCheck %s --check-prefix=SELECT
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-inline-libcall 2>&1 | FileCheck %s --check-prefix=INLINE
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL

// SELECT-LABEL: func.func @tcvt_one_vl_selection
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "vmi_tcvt"
// SELECT-SAME: pto.tilelib.impl = "vmi"
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "vmi_tcvt"
// SELECT-SAME: pto.tilelib.impl = "vmi"
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "template_tcvt_bf16_to_f32"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "template_tcvt_bf16_to_f32"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "template_tcvt_bf16_to_f32"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"
// SELECT: pto.tcvt
// SELECT-SAME: pto.tilelib.candidate = "template_tcvt_f32_to_bf16"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"

// INLINE-LABEL: func.func @tcvt_one_vl_selection
// INLINE: pto.vmi.vcvt %{{.*}} : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
// INLINE: pto.vmi.vcvt %{{.*}} {{.*}} : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>

// FINAL-LABEL: func.func @tcvt_one_vl_selection
// FINAL: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// FINAL-NOT: pto.vmi.

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tcvt_one_vl_selection() {
    %src_bf16 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xbf16>
    %dst_f32 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %src_f32 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %dst_bf16 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xbf16>
    %wide_bf16 = pto.alloc_tile : !pto.tile_buf<vec, 1x128xbf16>
    %wide_f32 = pto.alloc_tile : !pto.tile_buf<vec, 1x128xf32>
    %tail_bf16 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xbf16, valid=1x32>
    %tail_f32 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32, valid=1x32>

    pto.tcvt ins(%src_bf16 {
        rmode = #pto<round_mode CAST_RINT>,
        satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x64xbf16>)
      outs(%dst_f32 : !pto.tile_buf<vec, 1x64xf32>)
    pto.tcvt ins(%src_f32 {
        rmode = #pto<round_mode RINT>,
        satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x64xf32>)
      outs(%dst_bf16 : !pto.tile_buf<vec, 1x64xbf16>)
    pto.tcvt ins(%wide_bf16 {
        rmode = #pto<round_mode CAST_RINT>,
        satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x128xbf16>)
      outs(%wide_f32 : !pto.tile_buf<vec, 1x128xf32>)
    pto.tcvt ins(%tail_bf16 {
        rmode = #pto<round_mode CAST_RINT>,
        satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x64xbf16, valid=1x32>)
      outs(%tail_f32 : !pto.tile_buf<vec, 1x64xf32, valid=1x32>)
    pto.tcvt ins(%src_bf16 {
        rmode = #pto<round_mode CAST_RINT>,
        satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 1x64xbf16>)
      outs(%dst_f32 : !pto.tile_buf<vec, 1x64xf32>)
    pto.tcvt ins(%src_f32 {
        rmode = #pto<round_mode TRUNC>,
        satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x64xf32>)
      outs(%dst_bf16 : !pto.tile_buf<vec, 1x64xbf16>)
    return
  }
}
