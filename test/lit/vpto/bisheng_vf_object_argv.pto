// The fake toolchain records the final Bisheng argv. Ordinary VPTO object
// emission must not inherit VMI-only VF disabling flags; the explicit VMI
// pipeline must pass them and force auto-sync off with the rest of Bisheng VF.
// RUN: rm -rf %t.toolchain && mkdir -p %t.toolchain/bin %t.toolchain/tools/bisheng_compiler/bin %t.toolchain/include %t.toolchain/pkg_inc
// RUN: cp %S/../resources/fake_bisheng.sh %t.toolchain/bin/bisheng
// RUN: cp %S/../resources/fake_bisheng.sh %t.toolchain/tools/bisheng_compiler/bin/bisheng
// RUN: cp %S/../resources/fake_ld_lld.sh %t.toolchain/bin/ld.lld
// RUN: cp %S/../resources/fake_ld_lld.sh %t.toolchain/bin/cce-ld
// RUN: chmod +x %t.toolchain/bin/bisheng %t.toolchain/tools/bisheng_compiler/bin/bisheng %t.toolchain/bin/ld.lld %t.toolchain/bin/cce-ld
// RUN: touch %t.toolchain/include/__clang_cce_runtime_wrapper.h
// RUN: env ASCEND_HOME_PATH=%t.toolchain FAKE_BISHENG_LOG=%t.normal.log ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t.normal.o
// RUN: env ASCEND_HOME_PATH=%t.toolchain FAKE_BISHENG_LOG=%t.vmi.log ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto %s -o %t.vmi.o
// RUN: env ASCEND_HOME_PATH=%t.toolchain FAKE_BISHENG_LOG=%t.explicit.log ptoas --enable-vmi --enable-op-fusion --bisheng-vf-auto-sync=global --pto-arch=a5 --pto-backend=vpto %s -o %t.explicit.o
// RUN: FileCheck %s --check-prefix=NORMAL < %t.normal.log
// RUN: FileCheck %s --check-prefix=VMI < %t.vmi.log
// RUN: FileCheck %s --check-prefix=EXPLICIT < %t.explicit.log

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @bisheng_vf_object_argv() attributes {pto.kernel} {
    return
  }
}

// The historical file also drove this contract with an explicit
// --disable-bisheng-vf-fusion CLI (and --bisheng-vf-auto-sync).  That option is
// deliberately not restored on this mainline: the VMI device route decides by
// itself whether Bisheng's VF passes stand down, so the VMI variant below is the
// mechanism, and the removed CLI has no equivalent to assert.
// Ordinary VPTO object emission must not inherit the VMI-only VF disabling
// flags, while the explicit VMI route must pass all six plus the scheduler
// switch -- that is the device-route contract this mainline implements.
// The VMI flag order below is the order ObjectEmission.cpp emits it in; the
// flags are independent -mllvm options, so only their presence is contractual,
// but FileCheck matches in order and a single device invocation (as opposed to
// the repeated one a fake toolchain may record) exposes any mismatch.
// NORMAL-NOT: -cce-vf-enable-vf-fusion=false
// NORMAL-NOT: -cce-vf-enable-loop-fusion=false
// NORMAL-NOT: --cce-aicore-vec-misched=0
// VMI: -cce-vf-auto-sync=off
// VMI: -cce-vf-enable-vf-fusion=false
// VMI: -cce-vf-enable-vf-loop-extender=false
// VMI: -cce-vf-enable-loop-fusion=false
// VMI: -cce-vf-enable-vf-ldst-elimination=false
// VMI: -cce-vf-enable-ub-dead-st-elimination=false
// VMI: -cce-vf-enable-vf-ifelse-extender=false
// VMI: --cce-aicore-vec-misched=0
// VMI-NOT: -cce-vf-auto-sync=global
//
// An explicit --bisheng-vf-auto-sync is honoured by the route rather than
// overridden: the historical file asserted the opposite precedence, which this
// mainline changed deliberately.  The switch precedes the VF-disabling flags in
// the emitted argv, hence the order of the two checks.
// EXPLICIT: -cce-vf-auto-sync=global
// EXPLICIT: -cce-vf-enable-vf-fusion=false
// EXPLICIT-NOT: -cce-vf-auto-sync=off
