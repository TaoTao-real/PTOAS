// RUN: pto-test-opt --pto-vmi-state-promotion %s | FileCheck %s --check-prefix=GENERIC
// RUN: pto-test-opt --pto-vmi-state-promotion='mode=shadow' %s | FileCheck %s --check-prefix=SHADOW
// RUN: pto-test-opt --pto-vmi-state-promotion='max-vector-chunks=1' %s | FileCheck %s --check-prefix=PRESSURE

!vec = !pto.tile_buf<vec, 1x64xf32>
!scalar = !pto.tile_buf<vec, 1x8xf32>

module {
  func.func private @side_effect()
  func.func private @observe(!pto.ptr<f32, ub>)

  // GENERIC-LABEL: func.func @loop_carried
  // GENERIC: pto.vmi.vbrc
  // GENERIC: %[[LOOP:.*]] = scf.for {{.*}} iter_args(%[[CARRY:.*]] = %{{.*}}) -> (!pto.vmi.vreg<64xf32>) {
  // GENERIC: %[[NEXT:.*]] = pto.vmi.vadd %[[CARRY]],
  // GENERIC: pto.yield(%[[NEXT]])
  // GENERIC: scf.yield %{{.*}} : !pto.vmi.vreg<64xf32>
  // GENERIC: } {pto.vmi.state_promotion.flow = "loop-carried"
  // GENERIC: pto.vmi.vcadd %[[LOOP]],
  // GENERIC-NOT: pto.vmi.vload
  // GENERIC-NOT: pto.vmi.vstore
  // SHADOW-LABEL: func.func @loop_carried
  // SHADOW: scf.for
  // SHADOW: pto.vmi.vload
  // SHADOW: pto.vmi.vstore
  // SHADOW: } {pto.vmi.state_promotion.flow = "loop-carried"
  // SHADOW-SAME: pto.vmi.state_promotion.shadow = "generic-only"
  // PRESSURE-LABEL: func.func @loop_carried
  // PRESSURE: scf.for
  // PRESSURE: pto.vmi.vload
  // PRESSURE: pto.vmi.vstore
  // PRESSURE: } {pto.vmi.state_promotion.detail = "physical-chunk-budget-exceeded"
  // PRESSURE-SAME: pto.vmi.state_promotion.reason = "resource-pressure"
  func.func @loop_carried() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 1024 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    "pto.fusion_region"() ({
      %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
      %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      %init = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
      pto.vmi.vstore %init, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
      pto.yield() : () -> ()
    }) : () -> ()
    scf.for %i = %c0 to %c4 step %c1 {
      "pto.fusion_region"() ({
        %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
        %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
        %old = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        %delta = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
        %next = pto.vmi.vadd %old, %delta, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
        pto.vmi.vstore %next, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
        pto.yield() : () -> ()
      }) : () -> ()
    }
    "pto.fusion_region"() ({
      %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
      %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      %value = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %sum = pto.vmi.vcadd %value, %mask {reassoc} : !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xf32>
      pto.yield() : () -> ()
    }) : () -> ()
    return
  }

  // GENERIC-LABEL: func.func @straight_line_broadcast
  // GENERIC: %[[SCALAR:.*]] = pto.vmi.vcadd
  // GENERIC: pto.yield(%[[SCALAR]])
  // GENERIC: %[[BRC:.*]] = pto.vmi.vbrc %{{.*}} : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<64xf32>
  // GENERIC: pto.vmi.vadd %[[BRC]],
  // GENERIC-NOT: pto.vmi.vload
  // GENERIC-NOT: pto.vmi.vstore
  func.func @straight_line_broadcast() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 4096 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !scalar
    "pto.fusion_region"() ({
      %ptr = pto.tile_buf_addr %state : !scalar -> !pto.ptr<f32, ub>
      %mask1 = pto.vmi.create_mask %c1 : index -> !pto.vmi.mask<1xpred>
      %wide = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
      %mask64 = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      %scalar = pto.vmi.vcadd %wide, %mask64 {reassoc} : !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xf32>
      pto.vmi.vstore %scalar, %ptr[%c0], %mask1 : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<1xpred>
      pto.yield() : () -> ()
    }) : () -> ()
    "pto.fusion_region"() ({
      %ptr = pto.tile_buf_addr %state : !scalar -> !pto.ptr<f32, ub>
      %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      %broadcast = pto.vmi.vload %ptr[%c0] {dist_mode = "brc"} : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %zero_vec = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
      %result = pto.vmi.vadd %broadcast, %zero_vec, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
      pto.yield() : () -> ()
    }) : () -> ()
    return
  }

  // GENERIC-LABEL: func.func @dynamic_mask_rejected
  // GENERIC: pto.vmi.vstore{{.*}}pto.vmi.state_promotion.reason = "mask"
  // GENERIC: pto.vmi.vload
  func.func @dynamic_mask_rejected(%lanes: index) {
    %c0 = arith.constant 0 : index
    %addr = arith.constant 8192 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %lanes : index -> !pto.vmi.mask<64xpred>
    %value = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %value, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    %reload = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    return
  }

  // GENERIC-LABEL: func.func @multi_consumer
  // GENERIC: %[[VALUE:.*]] = pto.vmi.vbrc
  // GENERIC: pto.vmi.vadd %[[VALUE]],
  // GENERIC: pto.vmi.vmul %[[VALUE]],
  // GENERIC-NOT: pto.vmi.vload
  // GENERIC-NOT: pto.vmi.vstore
  func.func @multi_consumer() {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 10240 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    %ptr0 = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
    %value = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %value, %ptr0[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    %ptr1 = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %first = pto.vmi.vload %ptr1[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    %sum = pto.vmi.vadd %first, %value, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    %ptr2 = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %second = pto.vmi.vload %ptr2[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    %product = pto.vmi.vmul %second, %sum, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    return
  }

  // GENERIC-LABEL: func.func @static_prefix
  // GENERIC: pto.vmi.vadd
  // GENERIC-NOT: pto.vmi.vload
  // GENERIC-NOT: pto.vmi.vstore
  func.func @static_prefix() {
    %c0 = arith.constant 0 : index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 11264 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %c32 : index -> !pto.vmi.mask<64xpred>
    %value = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %value, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    %reload = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    %result = pto.vmi.vadd %reload, %value, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    return
  }

  // GENERIC-LABEL: func.func @partial_alias_rejected
  // GENERIC: pto.vmi.vload{{.*}}pto.vmi.state_promotion.detail = "partial-or-different-byte-range"
  // GENERIC-SAME: pto.vmi.state_promotion.reason = "alias"
  func.func @partial_alias_rejected() {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %base = arith.constant 12288 : i64
    %overlap = arith.constant 12416 : i64
    %zero = arith.constant 0.0 : f32
    %producer = pto.alloc_tile addr = %base : !vec
    %consumer = pto.alloc_tile addr = %overlap : !vec
    %producer_ptr = pto.tile_buf_addr %producer : !vec -> !pto.ptr<f32, ub>
    %consumer_ptr = pto.tile_buf_addr %consumer : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
    %value = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %value, %producer_ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    %reload = pto.vmi.vload %consumer_ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    return
  }

  // GENERIC-LABEL: func.func @loop_invariant
  // GENERIC: %[[HOIST:.*]] = pto.vmi.vload
  // GENERIC: scf.for
  // GENERIC: pto.vmi.vadd %[[HOIST]],
  // GENERIC-NOT: pto.vmi.vload
  func.func @loop_invariant() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 13312 : i64
    %zero = arith.constant 0.0 : f32
    %input = pto.alloc_tile addr = %addr : !vec
    scf.for %i = %c0 to %c4 step %c1 {
      "pto.fusion_region"() ({
        %ptr = pto.tile_buf_addr %input : !vec -> !pto.ptr<f32, ub>
        %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
        %value = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        %zero_vec = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
        %sum = pto.vmi.vadd %value, %zero_vec, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
        pto.yield() : () -> ()
      }) : () -> ()
    }
    return
  }

  // GENERIC-LABEL: func.func @zero_trip_loop
  // GENERIC: scf.for {{.*}} iter_args
  // GENERIC-SAME: -> (!pto.vmi.vreg<64xf32>)
  // GENERIC: pto.vmi.state_promotion.status = "accepted"
  // GENERIC-NOT: pto.vmi.vload
  // GENERIC-NOT: pto.vmi.vstore
  func.func @zero_trip_loop() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 14336 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
    %init = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %init, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    scf.for %i = %c0 to %c0 step %c1 {
      %old = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %next = pto.vmi.vadd %old, %init, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
      pto.vmi.vstore %next, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    }
    %final = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    %sum = pto.vmi.vcadd %final, %mask {reassoc} : !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xf32>
    return
  }

  // GENERIC-LABEL: func.func @unknown_effect_rejected
  // GENERIC: scf.for
  // GENERIC: pto.vmi.vload
  // GENERIC: func.call @side_effect
  // GENERIC: pto.vmi.vstore
  // GENERIC: pto.vmi.state_promotion.reason = "unknown-effect"
  func.func @unknown_effect_rejected() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %addr = arith.constant 15360 : i64
    %zero = arith.constant 0.0 : f32
    %state = pto.alloc_tile addr = %addr : !vec
    %ptr = pto.tile_buf_addr %state : !vec -> !pto.ptr<f32, ub>
    %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
    %init = pto.vmi.vbrc %zero : f32 -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %init, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    scf.for %i = %c0 to %c4 step %c1 {
      %old = pto.vmi.vload %ptr[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %next = pto.vmi.vadd %old, %init, %mask : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
      func.call @side_effect() : () -> ()
      pto.vmi.vstore %next, %ptr[%c0], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
    }
    return
  }

  // GENERIC-LABEL: func.func @nested_control_rejected
  // GENERIC: scf.for
  // GENERIC: pto.vmi.vload
