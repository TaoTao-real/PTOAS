  // GENERIC-LABEL: func.func @escape_rejected
  // GENERIC: scf.for
  // GENERIC: pto.vmi.vload
  // GENERIC: pto.vmi.vstore
  // GENERIC: pto.vmi.state_promotion.reason = "escape"
