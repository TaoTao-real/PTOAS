// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --vmi-fusion-mode=off --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-select-tilelib-candidate 2>&1 | FileCheck %s --check-prefix=SELECT
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --vmi-fusion-mode=off --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-inline-libcall 2>&1 | FileCheck %s --check-prefix=INLINE
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --tilelib-candidate-policy=prefer-vmi --vmi-fusion-mode=off --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL

// SELECT-LABEL: func.func @texpands_one_vl_selection
// SELECT: pto.texpands
// SELECT-SAME: pto.tilelib.candidate = "vmi_texpands"
// SELECT-SAME: pto.tilelib.impl = "vmi"
// SELECT: pto.texpands
// SELECT-SAME: pto.tilelib.candidate = "template_texpands"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"
// SELECT: pto.texpands
// SELECT-SAME: pto.tilelib.candidate = "template_texpands"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"
// SELECT: pto.texpands
// SELECT-SAME: pto.tilelib.candidate = "template_texpands"
// SELECT-SAME: pto.tilelib.impl = "ptodsl"

// INLINE-LABEL: func.func @texpands_one_vl_selection
// INLINE: %[[BROADCAST:.+]] = pto.vmi.vbrc %{{.*}} : f32 -> !pto.vmi.vreg<64xf32>
// INLINE: pto.vmi.vstore %[[BROADCAST]], %{{.*}}[{{.*}}], %{{.*}}

// FINAL-LABEL: func.func @texpands_one_vl_selection
// FINAL: %[[DUP:.+]] = pto.vdup %{{.*}}, %{{.*}} : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
// FINAL: pto.vsts %[[DUP]], %{{.*}}[{{.*}}], %{{.*}}
// FINAL-NOT: pto.vmi.v

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @texpands_one_vl_selection() {
    %zero = arith.constant 0.0 : f32
    %half = arith.constant 5.0e-01 : f16
    %one_vl = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %two_rows = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %tail = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32, valid=1x32>
    %f16 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf16>

    pto.texpands ins(%zero : f32)
      outs(%one_vl : !pto.tile_buf<vec, 1x64xf32>)
    pto.texpands ins(%zero : f32)
      outs(%two_rows : !pto.tile_buf<vec, 2x64xf32>)
    pto.texpands ins(%zero : f32)
      outs(%tail : !pto.tile_buf<vec, 1x64xf32, valid=1x32>)
    pto.texpands ins(%half : f16)
      outs(%f16 : !pto.tile_buf<vec, 1x64xf16>)
    return
  }
}
