// A DMA transfer between two VMI computes is a hard fusion-region boundary.
//
// The first tadd forms region 0, the tload must stay outside every region,
// and the second tadd forms region 1: exactly two regions with the DMA
// transfer between them.

// RUN: pto-test-opt %s '--pto-fusion-plan=fusion-strategy=vmi-ub-disjoint' --pto-fusion-region-gen | FileCheck %s

module {
  // CHECK-LABEL: func.func @dma_between_compute
  // CHECK: pto.fusion_region
  // CHECK: pto.tadd
  // CHECK: pto.fusion.group_id = 0
  // CHECK: pto.tload
  // CHECK: pto.fusion_region
  // CHECK: pto.tadd
  // CHECK: pto.fusion.group_id = 1
  // CHECK-NOT: pto.fusion_region
  func.func @dma_between_compute(%view: !pto.partition_tensor_view<1x64xf32>) {
    %a = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    %b = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    %d = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %e = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    pto.tadd ins(%a, %b : !pto.tile_buf<vec, 64x64xf32>, !pto.tile_buf<vec, 64x64xf32>) outs(%c : !pto.tile_buf<vec, 64x64xf32>)
    pto.tload ins(%view : !pto.partition_tensor_view<1x64xf32>) outs(%d : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadd ins(%c, %e : !pto.tile_buf<vec, 64x64xf32>, !pto.tile_buf<vec, 64x64xf32>) outs(%e : !pto.tile_buf<vec, 64x64xf32>)
    return
  }
}
