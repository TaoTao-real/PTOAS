// Regression test for the VMI VF fusion passes (US-005 mem2reg for the fa
// softmax chain ColMax -> tmuls -> ColExpand-sub -> tmuls -> texp -> ColSum ->
// tcvt). Verifies:
//   PLAN   - PTOPlanVmiFusionRegion merges the per-TileOp fusion_region ops
//            (one per compute TileOp) into a single group region.
//   LOOP   - PTOVmiLoopFusion fuses the same-header scf.for ops inside the
//            group region into one fused scf.for carrying both reduce
//            accumulators (ColMax vmax + ColSum vadd) as iter_args.
//   ELIDE  - PTOVmiLoadStoreElision forwards a vmi.vstore to a matching
//            vmi.vload inside the fused loop body, erasing both (UB roundtrip
//            elimination).
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl-vmi \
// RUN:   --emit-vpto %S/../../samples/FlashAttention/fa_dn_softmax_128x64.pto \
// RUN:   -o /dev/null --mlir-print-ir-after=pto-plan-vmi-fusion-region 2>&1 \
// RUN:   | FileCheck %s --check-prefix=PLAN
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl-vmi \
// RUN:   --emit-vpto %S/../../samples/FlashAttention/fa_dn_softmax_128x64.pto \
// RUN:   -o /dev/null --mlir-print-ir-after=pto-vmi-loop-fusion 2>&1 \
// RUN:   | FileCheck %s --check-prefix=LOOP
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl-vmi \
// RUN:   --emit-vpto %S/../../samples/FlashAttention/fa_dn_softmax_128x64.pto \
// RUN:   -o /dev/null --mlir-print-ir-after=pto-vmi-load-store-elision 2>&1 \
// RUN:   | FileCheck %s --check-prefix=ELIDE

// ---- PLAN - one fused group region, not seven -------------------------------
// PLAN: IR Dump After PTOPlanVmiFusionRegion
// PLAN-LABEL: func.func @fa_dn_softmax_128x64
// PLAN: pto.fusion_region {
// PLAN-NOT: pto.fusion_region {

// ---- LOOP - two reduce-for's kept separate; the element-wise tail fused ----
// The ColMax reduce is NOT fused with the ColExpand-sub loop that consumes its
// final result: the tmuls(scale ColMax) chain between them can neither hoist
// (reads the ColMax final UB) nor sink (its store is read by ColExpand-sub), so
// fusion stops there. ColMax stays a separate reduce for; the rest
// (ColExpand-sub, tmuls, texp, ColSum, tcvt) fuse into one for carrying the
// ColSum accumulator.
// LOOP: IR Dump After PTOVmiLoopFusion
// LOOP-LABEL: func.func @fa_dn_softmax_128x64
// LOOP: scf.for {{.*}} iter_args({{.*}}) -> (!pto.vmi.vreg<64xf32>) {
// LOOP: scf.for {{.*}} iter_args({{.*}}) -> (!pto.vmi.vreg<64xf32>) {

// ---- ELIDE - at least one vmi.vload / vmi.vstore pair eliminated -----------
// ELIDE: IR Dump After PTOVmiLoadStoreElision
// ELIDE-LABEL: func.func @fa_dn_softmax_128x64
// ELIDE: pto.vmi.vload
// ELIDE: pto.vmi.vstore
