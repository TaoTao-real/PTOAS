// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-level=level3 --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_fusion_region_compact_shape_state() {
    %c0_i64 = arith.constant 0 : i64
    %c32_i64 = arith.constant 32 : i64
    %c64_i64 = arith.constant 64 : i64
    %c1 = arith.constant 1 : index

    %lhs = pto.alloc_tile addr = %c0_i64 valid_row = %c1 valid_col = %c1
      : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
    %rhs = pto.alloc_tile addr = %c32_i64 valid_row = %c1 valid_col = %c1
      : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
    %region = pto.fusion_region {
      %inner = pto.alloc_tile addr = %c64_i64 valid_row = %c1 valid_col = %c1
        : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
      pto.tadd ins(%lhs, %rhs :
          !pto.tile_buf<vec, 1x8xf32, valid=?x?>,
          !pto.tile_buf<vec, 1x8xf32, valid=?x?>)
        outs(%inner : !pto.tile_buf<vec, 1x8xf32, valid=?x?>)
      pto.yield(%inner) : (!pto.tile_buf<vec, 1x8xf32, valid=?x?>) -> ()
    } : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
    %dst = pto.alloc_tile addr = %c0_i64 valid_row = %c1 valid_col = %c1
      : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
    pto.tadd ins(%lhs, %region :
        !pto.tile_buf<vec, 1x8xf32, valid=?x?>,
        !pto.tile_buf<vec, 1x8xf32, valid=?x?>)
      outs(%dst : !pto.tile_buf<vec, 1x8xf32, valid=?x?>)
    return
  }
}

// CHECK-COUNT-2: pto.vadd
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.tilelib.candidate = "template_tadd"
