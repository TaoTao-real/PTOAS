// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_compact_elementwise_candidate() {
    %scale = arith.constant 2.0 : f32
    %bias = arith.constant 1.0 : f32
    %lhs = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                           v_row=1, v_col=1, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    %rhs = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                           v_row=1, v_col=1, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    %tmp0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                            v_row=1, v_col=1, blayout=row_major,
                                            slayout=none_box, fractal=512, pad=0>
    %tmp1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                            v_row=1, v_col=1, blayout=row_major,
                                            slayout=none_box, fractal=512, pad=0>
    %tmp2 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                            v_row=1, v_col=1, blayout=row_major,
                                            slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                           v_row=1, v_col=1, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%lhs, %rhs :
        !pto.tile_buf<vec, 1x8xf32, valid=1x1>,
        !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
      outs(%tmp0 : !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
    pto.tmuls ins(%tmp0, %scale : !pto.tile_buf<vec, 1x8xf32, valid=1x1>, f32)
      outs(%tmp1 : !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
    pto.tadds ins(%tmp1, %bias : !pto.tile_buf<vec, 1x8xf32, valid=1x1>, f32)
      outs(%tmp2 : !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
    pto.tsqrt ins(%tmp2 : !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
      outs(%dst : !pto.tile_buf<vec, 1x8xf32, valid=1x1>)
    return
  }
}

// CHECK: pto.vadd
// CHECK: pto.vdup
// CHECK: pto.vmul
// CHECK: pto.vdup
// CHECK: pto.vadd
// CHECK: pto.vsqrt
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.tilelib.candidate = "template_tadd"
