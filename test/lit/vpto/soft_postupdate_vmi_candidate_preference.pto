// VMI candidate metadata enables the late physical-address optimization
// without enabling the global --enable-vpto-soft-postupdate experiment.
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vmi --emit-vpto %s -o - \
// RUN:   | FileCheck %s

// CHECK-LABEL: func.func @preferred
// CHECK: scf.for {{.*}} iter_args({{.*}}) -> (!pto.ptr<f32,
// CHECK: pto.vlds {{.*}} -> !pto.vreg<64xf32>, !pto.ptr<f32,
// CHECK: pto.vsts {{.*}} -> !pto.ptr<f32,
// CHECK: pto.tilelib.postupdate = true

// CHECK-LABEL: func.func @ordinary
// CHECK: scf.for
// CHECK-NOT: iter_args
// CHECK: pto.vlds {{.*}} -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vlds {{.*}} -> !pto.vreg<64xf32>, !pto.ptr
// CHECK: pto.vsts {{.*}} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @preferred() {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c1024 = arith.constant 1024 : index
    %c0_i64 = arith.constant 0 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %mask = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    pto.vecscope {
      scf.for %iv = %c0 to %c1024 step %c64 {
        %vec = pto.vlds %ub[%iv] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        pto.vsts %vec, %ub[%iv], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      } {pto.tilelib.postupdate = true}
    }
    return
  }

  func.func @ordinary() {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c1024 = arith.constant 1024 : index
    %c0_i64 = arith.constant 0 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %mask = pto.pge_b32 "PAT_ALL" : !pto.mask<b32>
    pto.vecscope {
      scf.for %iv = %c0 to %c1024 step %c64 {
        %vec = pto.vlds %ub[%iv] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        pto.vsts %vec, %ub[%iv], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      }
    }
    return
  }
}
