// The VMI vec-scalar emitter must stay on the modern entry points.  Stage 1
// moved _vvec_scalar off the deprecated _VMINamespace.<op>s accessors, which
// printed a PTODSLDeprecationWarning on every compile; the emitted IR was
// byte-identical, so the only observable was the warning count dropping to
// zero -- and nothing locked it.  tmins and tsubs both materialize through
// _vvec_scalar (vmin / vadd families), so a clean compile of either proves the
// shared helper still dispatches via pto.vmi.vmin / pto.vmi.vadd and no
// deprecation warning reaches the compiler output.

// RUN: ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tmins_scalar() {
    %c1 = arith.constant 1.0 : f32
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    // CHECK-NOT: PTODSLDeprecationWarning
    // CHECK-NOT: is deprecated
    // CHECK-LABEL: func.func @tmins_scalar
    // CHECK: pto.vmins
    // CHECK-NOT: PTODSLDeprecationWarning
    // CHECK-NOT: is deprecated
    pto.tmins ins(%src, %c1 : !pto.tile_buf<vec, 8x64xf32>, f32)
      outs(%dst : !pto.tile_buf<vec, 8x64xf32>)
    return
  }
  func.func @tsubs_scalar() {
    %c1 = arith.constant 1.0 : f32
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    // CHECK-NOT: PTODSLDeprecationWarning
    // CHECK-NOT: is deprecated
    // CHECK-LABEL: func.func @tsubs_scalar
    // CHECK: pto.vadds
    // CHECK-NOT: PTODSLDeprecationWarning
    // CHECK-NOT: is deprecated
    pto.tsubs ins(%src, %c1 : !pto.tile_buf<vec, 8x64xf32>, f32)
      outs(%dst : !pto.tile_buf<vec, 8x64xf32>)
    return
  }
}
