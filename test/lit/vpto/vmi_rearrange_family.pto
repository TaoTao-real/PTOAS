// RUN: pto-test-opt %s --mlir-disable-threading --pass-pipeline='builtin.module(func.func(pto-print-pre-fusion-analysis))' | FileCheck %s --check-prefix=DOMAIN
// RUN: pto-test-opt %s --pass-pipeline='builtin.module(func.func(pto-pre-fusion-analysis,pto-fusion-plan{fusion-strategy=vmi-ub-disjoint},pto-op-scheduling,pto-fusion-region-gen))' | FileCheck %s --check-prefix=FUSION

// DOMAIN: compute[0] op=tchannel_split
// DOMAIN-SAME: family=rearrange
// DOMAIN-SAME: principal_rows=8
// DOMAIN-SAME: principal_row_proof=proven
// DOMAIN-SAME: principal_row_reason=none
// DOMAIN: compute[1] op=tchannel_merge
// DOMAIN-SAME: family=rearrange
// DOMAIN-SAME: principal_rows=8
// DOMAIN-SAME: principal_row_proof=proven
// DOMAIN-SAME: principal_row_reason=none

// FUSION-LABEL: func.func @rearrange_k2
// FUSION: pto.fusion_region {
// FUSION: pto.tchannel_split
// FUSION: pto.tchannel_merge
// FUSION: } {pto.fusion.group_id = 0 : i64}

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @rearrange_k2() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    %even = pto.alloc_tile : !pto.tile_buf<vec, 8x32xf32>
    %odd = pto.alloc_tile : !pto.tile_buf<vec, 8x32xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    pto.tchannel_split ins(%src : !pto.tile_buf<vec, 8x64xf32>) outs(%even, %odd : !pto.tile_buf<vec, 8x32xf32>, !pto.tile_buf<vec, 8x32xf32>) {pto.tilelib.impl = "vmi", pto.tilelib.candidate = "vmi_tchannel_split_k2"}
    pto.tchannel_merge ins(%even, %odd : !pto.tile_buf<vec, 8x32xf32>, !pto.tile_buf<vec, 8x32xf32>) outs(%dst : !pto.tile_buf<vec, 8x64xf32>) {pto.tilelib.impl = "vmi", pto.tilelib.candidate = "vmi_tchannel_merge_k2"}
    return
  }
}

