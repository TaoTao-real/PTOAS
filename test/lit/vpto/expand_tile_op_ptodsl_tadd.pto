// InsertTemplateAttributes records a compact, ordered candidate list before
// fusion. The unified PTODSL backend exposes both ordinary PTODSL templates and
// legal VMI candidates to the compiler. SelectTileLibCandidate runs before
// fusion and records the decision that ExpandTileOp later consumes.
//
// Running without --enable-op-fusion proves metadata insertion is not gated
// by fusion. Printing before FusionPlan proves its position when fusion is on.
//
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --emit-pto-ir --mlir-print-ir-after=pto-insert-template-attributes %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=META
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --emit-pto-ir --mlir-print-ir-after=pto-select-tilelib-candidate %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=PRESELECT
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --emit-pto-ir --tilelib-candidate-policy=ordinary --mlir-print-ir-after=pto-select-tilelib-candidate %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=ORDINARY
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --pto-level=level2 --enable-op-fusion --emit-pto-ir --mlir-print-ir-before=pto-fusion-plan %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=PREFUSION
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --emit-vpto --mlir-print-ir-after=pto-expand-tile-op %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SELECT
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --ptodsl-python-exe=%python_executable --emit-vpto %s -o - 2>/dev/null | FileCheck %s --check-prefix=EXPAND

// META: pto.tadd
// META-SAME: candidates = [
// META-SAME: id = 0 : i64
// META-SAME: loop_depth = 2 : i64
// META-SAME: name = "template_tadd"
// META-SAME: postupdate = 0 : i64
// META-SAME: tags = ["elementwise", "binary"]
// META-SAME: tail = 0 : i64}
// META-SAME: id = 1000 : i64
// META-SAME: loop_depth = 1 : i64
// META-SAME: name = "vmi_tadd_block64"
// META-SAME: tags = ["vmi", "fusion_eligible", "single_logical_row_loop"]
// META-SAME: tail = 0 : i64}]

// PRESELECT: IR Dump After SelectTileLibCandidate
// PRESELECT: pto.tadd
// PRESELECT-SAME: pto.tilelib.candidate = "vmi_tadd_block64"
// PRESELECT-SAME: pto.tilelib.impl = "vmi"

// ORDINARY: IR Dump After SelectTileLibCandidate
// ORDINARY: pto.tadd
// ORDINARY-SAME: pto.tilelib.candidate = "template_tadd"
// ORDINARY-SAME: pto.tilelib.impl = "ptodsl"
// ORDINARY-SAME: pto.vmi.fusion.boundary = "local"

// PREFUSION: IR Dump Before FusionPlan
// PREFUSION: pto.tadd
// PREFUSION-SAME: candidates = [
// PREFUSION-SAME: pto.tilelib.candidate = "vmi_tadd_block64"
// PREFUSION-SAME: pto.tilelib.impl = "vmi"

// SELECT: call @{{.*}}__vmi_tadd_block64
// SELECT-SAME: pto.tilelib.candidate = "vmi_tadd_block64"
// SELECT-SAME: pto.tilelib.impl = "vmi"
// SELECT: func.func private @{{.*}}__vmi_tadd_block64
// SELECT: pto.vmi.vload
// SELECT: pto.vmi.vadd
// SELECT: pto.vmi.vstore

// EXPAND: func.func @TADD
// EXPAND-NOT: pto.tadd ins
// EXPAND: pto.vecscope
// EXPAND: pto.vadd
// EXPAND: pto.vsts
// EXPAND: pto.tilelib.candidate = "vmi_tadd_block64"
// EXPAND: pto.tilelib.impl = "vmi"

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TADD() {
    %a = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %b = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tadd ins(
      %a, %b
        : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(
        %dst
          : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                          blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
