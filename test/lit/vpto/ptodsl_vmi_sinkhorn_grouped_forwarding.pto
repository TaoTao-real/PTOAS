// A compact grouped reduction and its row-broadcast consumer share the same
// grouped_tile domain. The reduction store remains observable. The exact
// group-slot reload is intentionally retained because reload + vbrc combines
// into the direct group_broadcast_load/E2B physical form.

// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi \
// RUN:   --enable-op-fusion --enable-vmi-loop-fusion \
// RUN:   --enable-vmi-load-store-elision --pto-arch=a5 --pto-backend=vpto \
// RUN:   --tile-lib-backend=ptodsl --ptodsl-pkg-path=%S/../../../ptodsl \
// RUN:   --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null \
// RUN:   --mlir-print-ir-after=pto-vmi-load-store-elision 2>&1 \
// RUN:   | FileCheck %s --check-prefix=FORWARD

module {
  func.func @sinkhorn_reduce_broadcast() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x8xf32, valid=8x4, pad=3>
    %workspace = pto.alloc_tile : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>
    %state = pto.alloc_tile : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x8xf32, valid=8x4, pad=3>

    pto.trowmax
      ins(%src, %workspace : !pto.tile_buf<vec, 8x8xf32, valid=8x4, pad=3>, !pto.tile_buf<vec, 8x1xf32, blayout=col_major>)
      outs(%state : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>)
    pto.trowexpandsub
      ins(%src, %state : !pto.tile_buf<vec, 8x8xf32, valid=8x4, pad=3>, !pto.tile_buf<vec, 8x1xf32, blayout=col_major>)
      outs(%dst : !pto.tile_buf<vec, 8x8xf32, valid=8x4, pad=3>)
    return
  }
}

// FORWARD-LABEL: func.func @sinkhorn_reduce_broadcast
// FORWARD: %[[REDUCED:.*]] = pto.vmi.vcmax
// FORWARD: pto.vmi.vstore %[[REDUCED]], {{.*}} {group = 8 : i64}
// FORWARD: %[[RELOAD:.*]] = pto.vmi.vload {{.*}} {group = 8 : i64}
// FORWARD: %[[BROADCAST:.*]] = pto.vmi.vbrc %[[RELOAD]] {group = 8 : i64}
// FORWARD: pto.vmi.vsub
