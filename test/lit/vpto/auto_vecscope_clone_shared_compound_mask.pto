// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @clone_shared_compound_mask() {
      %c0 = arith.constant 0 : index
      %c0_i64 = arith.constant 0 : i64
      %c1024_i64 = arith.constant 1024 : i64
      %cst = arith.constant 0.0 : f32
      %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
      %ub1 = pto.castptr %c1024_i64 : i64 -> !pto.ptr<f32, ub>
      %vl32 = pto.pset_b32 "PAT_VL32" : !pto.mask<b32>
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %mask = pto.pand %vl32, %all, %all
          : !pto.mask<b32>, !pto.mask<b32>, !pto.mask<b32> -> !pto.mask<b32>
      %zero0 = pto.vdup %cst, %mask
          : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %zero0, %ub0[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.barrier #pto.pipe<PIPE_ALL>
      %zero1 = pto.vdup %cst, %mask
          : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %zero1, %ub1[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      return
    }
  }
}

// CHECK: pto.vecscope {
// CHECK: pto.pand
// CHECK: pto.vecscope {
// CHECK: pto.pand
