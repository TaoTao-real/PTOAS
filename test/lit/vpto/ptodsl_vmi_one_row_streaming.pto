// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-expand-tile-op 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL --implicit-check-not=pto.vmi.v

module {
  func.func @ptodsl_vmi_one_row_streaming() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4032 = arith.constant 4032 : index
    %c4096 = arith.constant 4096 : index
    %src_bf16 = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xbf16, valid=?x?>
    %src_f32 = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    %square = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    %workspace = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    %sum = pto.alloc_tile valid_row = %c1 valid_col = %c1
      : !pto.tile_buf<vec, 1x8xf32, valid=?x?>
    %broadcast = pto.alloc_tile valid_row = %c1 valid_col = %c1
      : !pto.tile_buf<vec, 8x1xf32, valid=?x?, blayout=col_major>
    %normalized = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    %dst_bf16 = pto.alloc_tile valid_row = %c1 valid_col = %c4096
      : !pto.tile_buf<vec, 1x4096xbf16, valid=?x?>

    pto.tcvt ins(%src_bf16 {rmode = #pto<round_mode ROUND>}
        : !pto.tile_buf<vec, 1x4096xbf16, valid=?x?>)
      outs(%src_f32 : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
    pto.tmul ins(%src_f32, %src_f32
        : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>,
          !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
      outs(%square : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
    pto.trowsum ins(%square, %workspace
        : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>,
          !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
      outs(%sum : !pto.tile_buf<vec, 1x8xf32, valid=?x?>)
    pto.trowexpanddiv ins(%src_f32, %broadcast
        : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>,
          !pto.tile_buf<vec, 8x1xf32, valid=?x?, blayout=col_major>)
      outs(%normalized : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
    pto.tcvt ins(%normalized {rmode = #pto<round_mode RINT>}
        : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
      outs(%dst_bf16 : !pto.tile_buf<vec, 1x4096xbf16, valid=?x?>)

    %tail_src = pto.alloc_tile valid_row = %c1 valid_col = %c4032
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    %tail_dst = pto.alloc_tile valid_row = %c1 valid_col = %c4032
      : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>
    pto.tmul ins(%tail_src, %tail_src
        : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>,
          !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
      outs(%tail_dst : !pto.tile_buf<vec, 1x4096xf32, valid=?x?>)
    return
  }
}

// EXPAND-LABEL: func.func @ptodsl_vmi_one_row_streaming
// EXPAND: call {{.*}}__vmi_tcvt_one_row_streaming
// EXPAND: call {{.*}}__vmi_tmul_one_row_streaming
// EXPAND: call {{.*}}__vmi_trowsum_one_row_streaming
// EXPAND: call {{.*}}__vmi_trowexpanddiv_one_row_streaming
// EXPAND: call {{.*}}__vmi_tcvt_one_row_streaming
// EXPAND: call {{.*}}__template_tmul
// EXPAND-SAME: pto.tilelib.impl = "ptodsl"

// FINAL-LABEL: func.func @ptodsl_vmi_one_row_streaming
// FINAL: scf.for
// FINAL-SAME: step %{{.*}}
// FINAL: pto.vdiv
// FINAL: pto.vcvt
// FINAL: pto.vcadd
// FINAL: scf.for
// FINAL: pto.vmul
