// A 16-row row-reduce cannot be expressed inside the VMI instruction SPEC: the
// grouped row-reduce would need group = rows = 16, and the SPEC allows the group
// count 1, 2, 4 or 8 only (SPEC 1.6).  Even with --enable-vmi the VMI candidates
// are therefore inapplicable and the ordinary TileLib template must be selected
// -- the route falls back instead of emitting out-of-SPEC VMI IR.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand --enable-vmi %s -o - 2>&1 | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TROWMAX16() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=8, v_row=16, v_col=1,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.trowmax ins(%src, %tmp : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                                     blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                                 !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                                     blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=8, v_row=16, v_col=1,
                                     blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// The ordinary route is taken: no VMI op survives, and the ordinary reduction
// intrinsics are emitted instead.
// CHECK-LABEL: func.func @TROWMAX16
// CHECK: pto.vcmax
// CHECK-NOT: pto.vmi.
