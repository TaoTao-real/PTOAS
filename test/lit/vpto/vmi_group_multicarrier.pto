// Group counts describe logical groups across all physical carriers. The
// producer boundary must accept executable shapes beyond eight groups.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>/dev/null | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o %t.ll

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @group_multicarrier(
      %src: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    pto.vecscope {
      %v = pto.vmi.vload %src[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
      %m = pto.vmi.create_mask %c256 : index -> !pto.vmi.mask<256xpred>
      %r = pto.vmi.vcadd %v, %m {group = 32, reassoc}
          : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<32xf32>
      pto.vmi.vstore %r, %dst[%c0], %c1 {group = 32}
          : !pto.vmi.vreg<32xf32>, !pto.ptr<f32, ub>
    }
    return
  }

  func.func @group_i16_sixteen(
      %src: !pto.ptr<i16, ub>,
      %dst: !pto.ptr<i16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c512 = arith.constant 512 : index
    pto.vecscope {
      %v = pto.vmi.vload %src[%c0]
          : !pto.ptr<i16, ub> -> !pto.vmi.vreg<512xi16>
      %m = pto.vmi.create_mask %c512 : index -> !pto.vmi.mask<512xpred>
      %r = pto.vmi.vcadd %v, %m {group = 16}
          : !pto.vmi.vreg<512xi16>, !pto.vmi.mask<512xpred> -> !pto.vmi.vreg<16xi16>
      pto.vmi.vstore %r, %dst[%c0], %c1 {group = 16}
          : !pto.vmi.vreg<16xi16>, !pto.ptr<i16, ub>
      %b = pto.vmi.vbrc %r {group = 16}
          : !pto.vmi.vreg<16xi16> -> !pto.vmi.vreg<512xi16>
      pto.vmi.vstore %b, %dst[%c512]
          : !pto.vmi.vreg<512xi16>, !pto.ptr<i16, ub>
    }
    return
  }
}

// CHECK-LABEL: func.func @group_multicarrier
// CHECK: pto.vcgadd
// CHECK: pto.vsts
// CHECK-NOT: pto.vmi.

// CHECK-LABEL: func.func @group_i16_sixteen
// CHECK: pto.vcgadd
// CHECK: pto.vsts
// CHECK-NOT: pto.vmi.
