// FLOW-LABEL: func.func @rms_norm_1vl_ascendc_aligned
// FLOW: scf.for %{{.*}} = %c0 to %c8 step %c1
// FLOW: pto.texpands
// FLOW: scf.for %{{.*}} = %c0 to %c4096 step %c64
// FLOW: pto.tcvt ins(%{{.*}} : !pto.tile_buf<vec, 1x64xbf16>) outs(%{{.*}} : !pto.tile_buf<vec, 1x64xf32>)
// FLOW-NEXT: pto.tmul
// FLOW-NEXT: pto.tadd
// FLOW-COUNT-1: pto.trowsum
// FLOW: pto.tmuls
// FLOW: pto.tadds
// FLOW: pto.tsqrt
// FLOW: scf.for %{{.*}} = %c0 to %c4096 step %c64
// FLOW: pto.tcvt ins(%{{.*}} : !pto.tile_buf<vec, 1x64xbf16>) outs(%{{.*}} : !pto.tile_buf<vec, 1x64xf32>)
// FLOW: pto.tcvt ins(%{{.*}} : !pto.tile_buf<vec, 1x64xbf16>) outs(%{{.*}} : !pto.tile_buf<vec, 1x64xf32>)
// FLOW: pto.trowexpanddiv
// FLOW-NEXT: pto.tmul
// FLOW-NEXT: pto.tcvt ins(%{{.*}} {rmode = #pto<round_mode RINT>{{.*}}} : !pto.tile_buf<vec, 1x64xf32>) outs(%{{.*}} : !pto.tile_buf<vec, 1x64xbf16>)
// FLOW-NOT: pto.tcvt{{.*}}1x4096
// FLOW: pto.tstore

// PROMOTED-LABEL: func.func @rms_norm_1vl_ascendc_aligned
// PROMOTED: %[[ACC:.*]] = scf.for {{.*}} iter_args(%[[ITER:.*]] = %{{.*}}) -> (!pto.vreg<64xf32>)
