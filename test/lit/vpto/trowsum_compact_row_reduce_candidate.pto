// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @trowsum_compact_row_reduce_candidate() {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
                                           v_row=1, v_col=64, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
                                           v_row=1, v_col=64, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                           v_row=1, v_col=1, blayout=row_major,
                                           slayout=none_box, fractal=512, pad=0>
    pto.trowsum ins(%src, %tmp
                    : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
                                    v_row=1, v_col=64, blayout=row_major,
                                    slayout=none_box, fractal=512, pad=0>,
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
                                    v_row=1, v_col=64, blayout=row_major,
                                    slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                                v_row=1, v_col=1, blayout=row_major,
                                slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vsts
// CHECK-NOT: pto.tilelib.candidate = "template_trowsum"
// CHECK-NOT: pto.vmi.
