// VMI-route VfSimulator cost-model coverage, unrolling side.  On the VMI
// route the planner runs late: `pto-vfsim-unroll-planner` sits after
// VPTOCombineReductions and CSE at VPTO emission time, reads the loop-fusion
// markers, and annotates `pto.vfsim.unroll_factor` on the fused loop; the
// built-in `pto-unroll-loops` right behind it consumes the annotation.  (The
// tile route keeps the FusionPlan-embedded planner and annotates
// pto.fusion.row/col_unroll_factor instead; that path is covered by the
// tile_fusion vfsim tests.)
//
// Decisions below are cost-model snapshots for the pinned VfSimulator commit
// f4ba4ecaf1fc ("Align legacy template selection with PTOAS").  If the
// submodule is ever bumped and a decision changes, update the expected values
// together with the bump.
//
// The six-op chain (tadd/tmul x3) on a 32x128 tile makes the model pick
// AABBCC factor=7 (cycles=309).  The consumer rescales the streaming loop
// from step 64 to step 448, leaves 24 vadd/vmul pairs (3+3 ops x 7 in the
// loop plus a 3+3-op residual epilogue for the remaining 64 elements), and
// drops the consumed attribute.  The sibling test
// vmi_vfsim_nounroll_tadd_tmul.pto covers the NO_UNROLL decision.

// REQUIRES: vfsim-costmodel
// RUN: ptoas --enable-vmi --enable-vfsim-costmodel-optimization --dump-vfsim-unroll-test --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion=true --emit-vpto %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=VFSIM
// RUN: ptoas --enable-vmi --enable-vfsim-costmodel-optimization --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion=true --emit-vpto %s --mlir-print-ir-after=pto-vfsim-unroll-planner -o /dev/null 2>&1 | FileCheck %s --check-prefix=PLANNER
// RUN: ptoas --enable-vmi --enable-vfsim-costmodel-optimization --pto-backend=vpto --pto-arch=a5 --pto-level=level2 --enable-op-fusion=true --emit-vpto %s --mlir-print-ir-after=pto-unroll-loops -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNROLL

// VFSIM: selected mode=AABBCC factor=7 cycles=309

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_vfsim_unroll_tadd_tmul(
      %b_ptr: !pto.ptr<f32>, %c_ptr: !pto.ptr<f32>, %d_ptr: !pto.ptr<f32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c128 = arith.constant 128 : index
    %b_view = pto.make_tensor_view %b_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %c_view = pto.make_tensor_view %c_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %d_view = pto.make_tensor_view %d_ptr,
      shape = [%c32, %c128], strides = [%c128, %c1]
      : !pto.tensor_view<?x?xf32>
    %b_part = pto.partition_view %b_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %c_part = pto.partition_view %c_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %d_part = pto.partition_view %d_view,
      offsets = [%c0, %c0], sizes = [%c32, %c128]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x128xf32>
    %b = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %t0 = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %t1 = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    %d = pto.alloc_tile : !pto.tile_buf<vec, 32x128xf32>
    pto.tload ins(%b_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%b : !pto.tile_buf<vec, 32x128xf32>)
    pto.tload ins(%c_part : !pto.partition_tensor_view<32x128xf32>)
              outs(%c : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%b, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t1 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%t1, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t1 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tadd ins(%t1, %c : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%t0 : !pto.tile_buf<vec, 32x128xf32>)
    pto.tmul ins(%t0, %b : !pto.tile_buf<vec, 32x128xf32>, !pto.tile_buf<vec, 32x128xf32>)
             outs(%d : !pto.tile_buf<vec, 32x128xf32>)
    pto.tstore ins(%d : !pto.tile_buf<vec, 32x128xf32>)
               outs(%d_part : !pto.partition_tensor_view<32x128xf32>)
    return
  }
}

// The planner strips the loop-fusion markers while annotating the factor.
//
// PLANNER: } {pto.tilelib.impl = "vmi", pto.vfsim.unroll_factor = 7 : i32, pto.vmi.fusion.principal_loop, pto.vmi.fusion.source = "tilelib"}

// pto-unroll-loops runs twice per compile: once early in the
// persistent-fragment chain, before the planner has annotated anything, and
// once right after the planner.  With a single kernel the two dumps below are
// therefore strictly ordered (and the pass prints the early store as
// mte_ub_gm, the late one as copy_ubuf_to_gm).
//
// UNROLL: scf.for %{{[a-zA-Z0-9]+}} = %c0 to %c4096 step %c64 {
// UNROLL-COUNT-6: pto.v{{add|mul}}
// UNROLL: } {pto.tilelib.impl = "vmi", pto.vmi.fusion.principal_loop, pto.vmi.fusion.source = "tilelib", pto.vmi.loop_fused, pto.vmi.loop_fusion.id = 0 : i64}
// UNROLL: scf.for %{{[a-zA-Z0-9]+}} = %c0 to %c4032 step %c448 iter_args
// UNROLL-COUNT-48: pto.v{{add|mul}}
// UNROLL-NOT: pto.vfsim.unroll_factor
