// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --pto-backend=vpto --tile-lib-backend=ptodsl-vmi --emit-vpto %s -o /dev/null 2>&1 | FileCheck %s

module {
  func.func @branch_local_valid_shape_is_not_a_full_mask_candidate(%cond: i1) {
    %c0_i64 = arith.constant 0 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %c8192_i64 = arith.constant 8192 : i64
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %lhs = pto.alloc_tile addr = %c0_i64 valid_row = %c2 valid_col = %c64
      : !pto.tile_buf<vec, 2x64xf32, valid=?x?>
    %rhs = pto.alloc_tile addr = %c4096_i64 valid_row = %c2 valid_col = %c64
      : !pto.tile_buf<vec, 2x64xf32, valid=?x?>
    %dst = pto.alloc_tile addr = %c8192_i64 valid_row = %c2 valid_col = %c64
      : !pto.tile_buf<vec, 2x64xf32, valid=?x?>
    scf.if %cond {
      pto.set_validshape %lhs, %c1, %c64
        : !pto.tile_buf<vec, 2x64xf32, valid=?x?>
    }
    pto.tadd
      ins(%lhs, %rhs
          : !pto.tile_buf<vec, 2x64xf32, valid=?x?>,
            !pto.tile_buf<vec, 2x64xf32, valid=?x?>)
      outs(%dst : !pto.tile_buf<vec, 2x64xf32, valid=?x?>)
    return
  }
}

// CHECK: initial PTODSL VMI provider does not support dynamic valid_shape
